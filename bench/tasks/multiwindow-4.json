{
  "expect": "B:done 9902",
  "family": "multiwindow",
  "goal": "A second window titled 'Source' shows a transfer code. Enter that code into the Code field of the window titled 'B:', then click Apply.",
  "id": "multiwindow-4",
  "legacy": [
    {
      "op": "click",
      "target": "Code"
    },
    {
      "op": "type",
      "text": "9902"
    },
    {
      "op": "click",
      "target": "Apply"
    }
  ],
  "param": "9902",
  "v1": [
    {
      "args": {
        "condition": {
          "element": {
            "match": "exact",
            "name": "Transfer code"
          }
        },
        "timeout_ms": 10000
      },
      "tool": "wait_for"
    },
    {
      "args": {
