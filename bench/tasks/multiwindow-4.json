            "tool": "act"
          },
          {
            "args": {
              "action": "press",
              "target": {
                "query": {
                  "match": "exact",
                  "name": "Apply"
                }
              }
            },
            "tool": "act"
          },
          {
            "args": {
              "condition": {
                "window": {
                  "match": "exact",
                  "title": "B:done 9902"
                }
              },
              "timeout_ms": 5000
            },
            "tool": "wait_for"
          }
        ]
      },
      "tool": "run"
