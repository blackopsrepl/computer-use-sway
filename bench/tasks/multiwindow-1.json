{
 "id": "multiwindow-1",
 "family": "multiwindow",
 "param": "4821",
 "expect": "B:done 4821",
 "goal": "A second window titled 'Source' shows a transfer code. Enter that code into the Code field of the window titled 'B:', then click Apply.",
 "v1": [
  {
   "tool": "observe",
   "args": {
    "scope": "visible",
    "query": {
     "name": "Transfer code"
    }
   },
   "capture": {
    "code": "Transfer code: (\\d+)"
   }
  },
  {
   "tool": "run",
   "args": {
    "steps": [
     {
      "tool": "act",
      "args": {
       "target": {
        "query": {
         "name": "Code",
         "match": "exact"
        }
       },
       "action": "set_text",
       "text": "{code}"
      }
     },
     {
      "tool": "act",
      "args": {
       "target": {
        "query": {
         "name": "Apply",
         "match": "exact"
        }
       },
       "action": "press"
      }
     },
     {
      "tool": "wait_for",
      "args": {
       "condition": {
        "window": {
         "title": "B:done 4821",
         "match": "exact"
        }
       },
       "timeout_ms": 5000
      }
     }
    ]
   }
  }
 ],
 "legacy": [
  {
   "op": "click",
   "target": "Code"
  },
  {
   "op": "type",
   "text": "4821"
  },
  {
   "op": "click",
   "target": "Apply"
  }
 ]
}
