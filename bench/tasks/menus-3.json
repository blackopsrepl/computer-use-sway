{
 "id": "menus-3",
 "family": "menus",
 "param": "-",
 "expect": "B:done Open",
 "goal": "Choose File > Open from the window's menu bar.",
 "v1": [
  {
   "tool": "run",
   "args": {
    "steps": [
     {
      "tool": "act",
      "args": {
       "target": {
        "query": {
         "name": "File",
         "match": "exact"
        }
       },
       "action": "press"
      }
     },
     {
      "tool": "act",
      "args": {
       "target": {
        "query": {
         "name": "Open",
         "match": "exact"
        }
       },
       "action": "press"
      }
     },
     {
      "tool": "wait_for",
      "args": {
       "condition": {
        "window": {
         "title": "B:done Open",
         "match": "exact"
        }
       },
       "timeout_ms": 5000
      }
     }
    ]
   }
  }
 ],
 "legacy": [
  {
   "op": "click",
   "target": "File"
  },
  {
   "op": "click",
   "target": "Open"
  }
 ]
}
